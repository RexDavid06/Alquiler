# .dockerignore — Exclude files from Docker build context.
# Keeps image small and prevents secrets from leaking into the image.

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Django
*.sqlite3
staticfiles/
media/
*.log

# Environment / secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Version control
.git/
.gitignore

# Documentation
*.md
LICENSE

# Docker
docker-compose*.yml
Dockerfile
.dockerignore

# Testing
.coverage
htmlcov/
.pytest_cache/
