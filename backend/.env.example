# ============================================================
# Alquiler backend environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Docker users: docker-compose.yml overrides DB_HOST, DB_PORT,
# and DB_ENGINE to connect to the postgres container automatically.
# You still need to set POSTGRES_* vars below for the database container.
# ============================================================

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_ENGINE=sqlite
DB_NAME=alquiler
DB_USER=alquiler
DB_PASSWORD=strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# --- PostgreSQL container credentials (used by docker-compose) ---
POSTGRES_DB=alquiler
POSTGRES_USER=alquiler
POSTGRES_PASSWORD=alquiler_secret

# --- Redis ---
REDIS_URL=

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alquiler <no-reply@alquiler.example>

# --- Domain settings ---
INVITATION_TOKEN_TTL_HOURS=72
DEFAULT_CURRENCY=NGN
TRIAL_DURATION_DAYS=14

# --- Docker ---
WEB_PORT=8000
DB_PORT_EXTERNAL=5432
REDIS_PORT_EXTERNAL=6379

# --- Security ---
# AUTH_TOKEN_EXPIRY_DAYS=7
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# --- Logging ---
# LOG_LEVEL=INFO
