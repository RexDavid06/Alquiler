# Alquiler backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Local development uses SQLite by default (no DB_* vars needed).
# For PostgreSQL production set DB_ENGINE=postgres and the DB_* vars below.
DB_ENGINE=sqlite
DB_NAME=alquiler
DB_USER=alquiler
DB_PASSWORD=strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173

# --- Email (SMTP) ---
# MVP emails e.g. password reset and invitations route through the
# notification service / Django mail backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alquiler <no-reply@alquiler.example>

# --- Domain settings ---
INVITATION_TOKEN_TTL_HOURS=72
DEFAULT_CURRENCY=NGN