# ============================================================
# Alquiler backend environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Docker users: docker-compose.yml overrides DB_HOST, DB_PORT,
# and DB_ENGINE to connect to the postgres container automatically.
# You still need to set POSTGRES_* vars below for the database container.
#
# Deployed (free-tier) demo: set DEBUG=False and provide DJANGO_SECRET_KEY,
# ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, CSRF_TRUSTED_ORIGINS, SITE_URL and
# the DB_* variables. See DEPLOYMENT.md for the full reference.
# ============================================================

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
# Local dev defaults to SQLite; the DB_* block is used when DB_ENGINE=postgres.
DB_ENGINE=sqlite
DB_NAME=alquiler
DB_USER=alquiler
DB_PASSWORD=strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# --- PostgreSQL container credentials (used by docker-compose) ---
POSTGRES_DB=alquiler
POSTGRES_USER=alquiler
POSTGRES_PASSWORD=alquiler_secret

# --- Redis (optional for the demo; caching only) ---
# Leave empty to run without Redis. The demo works without it.
REDIS_URL=

# --- CORS / frontend ---
# Comma-separated origins. For the deployed admin web app:
#   https://alquiler-admin.example.com
# For Expo web or the demo frontend, the scheme+host of the built frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# CSRF trusted origins for the admin/browsable API on the deployed domain.
# Same origins as CORS_ALLOWED_ORIGINS (scheme://host[:port]).
CSRF_TRUSTED_ORIGINS=

# Base URL used when building invitation / password-reset links in emails.
# For the demo, point this at wherever the landlord/tenant UI is served.
SITE_URL=http://localhost:5173

# --- Email (SMTP) ---
# No SMTP for the free demo: use the console backend so emails print to the
# application log (they are NOT delivered, but nothing silently pretends
# otherwise). To send real mail later, switch to the SMTP backend and set
# the host/credentials below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Alquiler <no-reply@alquiler.example>

# --- Domain settings ---
INVITATION_TOKEN_TTL_HOURS=72
DEFAULT_CURRENCY=NGN
TRIAL_DURATION_DAYS=14

# --- Docker ---
WEB_PORT=8000
DB_PORT_EXTERNAL=5432
REDIS_PORT_EXTERNAL=6379

# --- Security ---
# AUTH_TOKEN_EXPIRY_DAYS=7
# AUTH_REFRESH_TOKEN_TTL_DAYS=90
# AUTH_DEVICE_LIMIT=20
# Security headers are enabled automatically when DEBUG=False.
# If the free-tier host already terminates TLS and does NOT forward
# `X-Forwarded-Proto: https`, set SECURE_SSL_REDIRECT=False to avoid
# redirect loops (documented in DEPLOYMENT.md).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# --- Logging ---
# LOG_LEVEL=INFO

# --- Gunicorn (used by the Docker image / deployed backend) ---
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# GUNICORN_BIND=0.0.0.0:8000