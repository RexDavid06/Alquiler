# ============================================================
# Alquiler admin web app (React + Vite) environment template.
# Copy to .env and adjust. Never commit .env.
# ============================================================

# Base URL of the Django REST backend (no trailing slash).
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Deployed demo: point at the deployed backend before `npm run build`:
# VITE_API_BASE_URL=https://alquiler-api.example.com/api/v1
#
# NOTE: Vite inlines VITE_* vars at build time — rebuild after changing.